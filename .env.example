export GITLAB_TOKEN=glpat-xxxxxxxx          # personal access token, scope read_api
# Option A: Slack bot token (chat:write) + channel in config.toml or here
export SLACK_BOT_TOKEN=xoxb-xxxxxxxx
# export SLACK_CHANNEL=C0123456789
# Option B: incoming webhook (posts to the channel chosen when creating it)
# export SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Option C (no Slack app needed): Workflow Builder webhook trigger with a "text" variable
# export SLACK_WORKFLOW_URL=https://hooks.slack.com/triggers/...
# YouTrack (optional): Profile → Account Security → New token, scope YouTrack
# export YOUTRACK_TOKEN=perm:xxxxxxxx
